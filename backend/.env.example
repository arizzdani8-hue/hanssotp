# Server
PORT=5000
NODE_ENV=production

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hanssotp
DB_PASS=your_db_password
DB_NAME=hanssotp

# JWT
JWT_SECRET=your_jwt_secret_change_this
JWT_ADMIN_SECRET=your_admin_jwt_secret_change_this
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=https://yourdomain.com

# Payment - Tripay
TRIPAY_API_KEY=your_tripay_api_key
TRIPAY_PRIVATE_KEY=your_tripay_private_key
TRIPAY_MERCHANT_CODE=your_tripay_merchant_code
TRIPAY_API_URL=https://tripay.co.id/api

# Payment - QRISPY
QRISPY_API_KEY=your_qrispy_api_key
QRISPY_API_URL=https://api.qrispy.com

# OTP Providers
FIVESIM_API_KEY=your_5sim_api_key
HEROSMS_API_KEY=your_herosms_api_key
NOKOSMURAH_API_KEY=your_nokosmurah_api_key

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# Logging
LOG_LEVEL=info
