APP_NAME="OTP Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=otpservice
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Payment Gateway - DOMPETX
DOMPETX_API_KEY=
DOMPETX_SECRET_KEY=
DOMPETX_MERCHANT_ID=
DOMPETX_API_URL=https://dompetx.com/api/v1

# Payment Gateway - Pakasir
PAKASIR_API_KEY=
PAKASIR_SECRET_KEY=
PAKASIR_MERCHANT_ID=
PAKASIR_API_URL=https://pakasir.com/api/v1

# WhatsApp Gateway (fonnte/mpwa)
WHATSAPP_GATEWAY=fonnte
FONNTE_TOKEN=
MPWA_API_URL=
MPWA_TOKEN=

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OTP Providers
FIVESIM_API_KEY=
HEROSMS_API_KEY=
HEROSMS_API_URL=https://herosms.com/api/v1
DITZNESIA_API_KEY=
DITZNESIA_API_URL=https://api.ditznesia.id/v1

# Admin Email (for first-time setup)
ADMIN_EMAIL=admin@example.com
